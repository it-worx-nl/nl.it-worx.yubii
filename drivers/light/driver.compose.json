{
  "$extends": "hub",
  "name": {
    "en": "Light / dimmer",
    "nl": "Lamp / dimmer"
  },
  "class": "light",
  "capabilities": [
    "onoff"
  ],
  "images": {
    "small": "/drivers/light/assets/images/small.png",
    "large": "/drivers/light/assets/images/large.png",
    "xlarge": "/drivers/light/assets/images/xlarge.png"
  },
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Hub connection",
        "nl": "Verbinding met de hub"
      },
      "children": [
        {
          "id": "host",
          "type": "text",
          "label": {
            "en": "IP address",
            "nl": "IP-adres"
          },
          "value": ""
        },
        {
          "id": "username",
          "type": "text",
          "label": {
            "en": "Username",
            "nl": "Gebruikersnaam"
          },
          "value": ""
        },
        {
          "id": "password",
          "type": "password",
          "label": {
            "en": "Password",
            "nl": "Wachtwoord"
          },
          "value": ""
        }
      ]
    }
  ]
}
